# Copy this file to .env and replace the placeholders with your local values.
# Never commit the real .env file.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=900
# Allow longer job descriptions to return complete structured JSON.
OLLAMA_MAX_PREDICT_JOB=2048
# Matching assesses all extracted requirements and may need more than 1024 tokens.
OLLAMA_MAX_PREDICT_MATCH=1536
# Keep Ollama model loaded between uploads (no effect on model output).
OLLAMA_KEEP_ALIVE=30m
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
